{
  "name": "rankit",
  "version": "1.0.0",
  "description": "A website that assists people in ranking items",
  "license": "ISC",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file=.env server/src/index.ts",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --project server/tsconfig.json --noEmit",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc --project server/tsconfig.json",
    "build:client": "npm --prefix client run build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
