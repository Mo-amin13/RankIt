# Copy to .env for local development. Never commit the real .env.

# Postgres connection string, e.g. from Neon. Locally: a development
# database. In production: set it in your host's dashboard, not in a file.
# While this stays commented out, rankings are kept in memory only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Production only (add it in your host's dashboard). Turns on Secure
# cookies, trust proxy and serving the built client.
# NODE_ENV=production

# Optional. Render sets PORT itself; locally it defaults to 3000.
# PORT=3000

# Optional. Proxies in front of the app in production. Render has three
# (Cloudflare, its edge and its load balancer), which is the default. Too few
# and all visitors share rate limits; too many and visitors can fake their IP.
# TRUST_PROXY_HOPS=3

# Optional. Where the built client lives (default: client/dist).
# CLIENT_DIR=client/dist
