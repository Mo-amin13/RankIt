# Copy to .env for local development. Never commit the real .env.

# Postgres connection string (Neon). Locally: the development branch.
# In production (Render): the main branch's pooled connection string.
# Leave unset to keep rankings in memory only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Set by Render in production; turns on Secure cookies, trust proxy and
# serving the built client.
# NODE_ENV=production

# Optional. Render sets PORT itself; locally it defaults to 3000.
# PORT=3000

# Optional. Proxies in front of the app in production (Render: 1).
# TRUST_PROXY_HOPS=1

# Optional. Where the built client lives (default: client/dist).
# CLIENT_DIR=client/dist
